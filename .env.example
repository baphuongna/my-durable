# Copy to .env at the repo root. `just net up <id>` copies the keys listed under
# `env_keys` in dpi-network.yaml into each device's ~/.dpi/backend.env.
OPENROUTER_API_KEY=sk-or-...

# Optional: call Jev through TypeSafe directly instead of OpenRouter (jev-damage-control).
# Add it to `env_keys` in dpi-network.yaml to send it to your devices.
# TYPESAFE_API_KEY=
