# Reference Caddy deployment — Durable Agent Network (P2-21, spec 05 §4).
#
# Placeholders (Caddy {$ENV} substitution, set by the operator environment):
#   DPI_PUBLIC_HOST  host:port Caddy listens on (the public origin)
#   DPI_TLS_CERT     full-chain PEM
#   DPI_TLS_KEY      private key (0600, managed outside the repo)
#   DPI_HUB_ADDR     loopback address of the hub process (e.g. 127.0.0.1:4781)
#   DPI_ADMIN_HASH   bcrypt hash for the single admin user (caddy hash-password;
#                    the PLAINTEXT never lives in this repo or in env logs)
#
# Auth matrix (05) — the exemption set is EXACT and EXHAUSTIVE:
#   exempt (exact path+method): GET /healthz · POST /api/pair/start ·
#   POST /api/pair/verify · POST /api/pair/request (device-initiated
#   enrollment — the device holds no Basic credential by design) ·
#   GET /share/<token> (public capability page — the 20-32-char token IS the boundary; R15 narrowed the matcher to the token shape) ·
#   GET /api/tunnel (WS upgrade) — everything else — including WRONG METHODS
#   on the exempt paths — requires HTTP Basic auth, and the Authorization
#   header is STRIPPED before the hub so device tokens and admin credentials
#   can never mix. The final handle is a matcher-less CATCH-ALL so no request
#   class falls through to Caddy's anonymous empty-200 default (audit run-1:
#   admin-matcher method-gap). Client-supplied XFF/XFP are overwritten from
#   the real connection.
{
	admin off
	auto_https off
	servers {
		protocols h1 h2
	}
}

https://{$DPI_PUBLIC_HOST} {
	# TLS 1.2 is the declared floor (05 §4) rather than a Caddy default that a
	# future build could change. Caddy adds a catch-all policy for handshakes whose
	# SNI does not match; that one keeps Caddy's own default (also 1.2), and
	# tests/caddy-tls.test.ts proves both paths refuse TLS 1.0/1.1.
	tls {$DPI_TLS_CERT} {$DPI_TLS_KEY} {
		protocols tls1.2 tls1.3
	}

	header {
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
		-X-Powered-By
	}

	# CSP is deliberately NOT set here. The hub owns content security per
	# response: the app shell is served with a restrictive document CSP
	# (script-src/style-src 'self' + fonts.googleapis.com, connect-src 'self',
	# frame-ancestors 'none', X-Frame-Options: DENY — hub main.ts) while
	# proxied device answers are locked down harder still (default-src 'none';
	# sandbox — hub proxy.ts). This block runs after proxying, so a CSP line
	# here would overwrite both of those per-route policies with one blanket
	# value: either it weakens device responses or it breaks the app shell.
	# Do not "harden" this file by adding one; the harness also runs without
	# Caddy, so the hub must be correct on its own either way.

	# Admin surface = everything except the exact exemptions below. The final
	# handle is a matcher-less catch-all: wrong-method requests on exempt paths
	# land here (Basic challenge), never in Caddy's empty-200 default.
	@tunnel {
		method GET
		path /api/tunnel
	}
	@pairstart {
		method POST
		path /api/pair/start
	}
	@pairverify {
		method POST
		path /api/pair/verify
	}
	@pairrequest {
		method POST
		path /api/pair/request
	}
	@share {
		method GET
		# R15 (run-2 h12): exempt ONLY the token-shaped share page (mirrors
		# shares.ts isToken) — a bare /share/* wildcard also exempted the hub's
		# SPA fallback, serving the operator app shell anonymously.
		path_regexp ^/share/[A-Za-z0-9_-]{20,32}$
	}
	@healthz {
		method GET
		path /healthz
	}

	# 1. Tunnel WebSocket: exempt from basic auth, Bearer preserved.
	handle @tunnel {
		reverse_proxy {$DPI_HUB_ADDR} {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
			flush_interval -1
		}
	}

	# 2-4. Exempt pairing entry points — strip any caller Authorization so
	# credentials never mix (04 §9).
	handle @pairstart {
		reverse_proxy {$DPI_HUB_ADDR} {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
			header_up -Authorization
			flush_interval -1
		}
	}

	handle @pairverify {
		reverse_proxy {$DPI_HUB_ADDR} {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
			header_up -Authorization
			flush_interval -1
		}
	}

	# Device-initiated enrollment (audit run-1: exemption drift): the machine
	# running `dpi pair --hub` holds no Basic credential BY DESIGN — the hub
	# guards this route with per-IP limits, failure windows and the device-mint
	# sub-cap; approval stays the only issuance gate.
	handle @pairrequest {
		reverse_proxy {$DPI_HUB_ADDR} {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
			header_up -Authorization
			flush_interval -1
		}
	}

	# Public share page (audit run-1: exemption drift): the tokenized link is
	# the designed boundary; the page is server-side rendered with zero scripts.
	handle @share {
		reverse_proxy {$DPI_HUB_ADDR} {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
			header_up -Authorization
		}
	}

	handle @healthz {
		reverse_proxy {$DPI_HUB_ADDR} {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
			header_up -Authorization
		}
	}

	# Everything else — every non-exempt path AND every wrong-method request
	# on an exempt path: basic auth, then STRIP Authorization before the hub.
	# Matcher-less = exhaustive (audit run-1: method-gap fallthrough).
	handle {
		basic_auth {
			admin {$DPI_ADMIN_HASH}
		}
		reverse_proxy {$DPI_HUB_ADDR} {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
			header_up -Authorization
			flush_interval -1
		}
	}
}
